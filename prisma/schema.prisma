generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  HR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  LEAVE_APPLIED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
}

model Employee {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  teamsUserId         String?  @unique
  // The bot's 1:1 chat with this person, captured from their messages - lets reminders
  // and auto check-out notices be sent proactively. Null until they first message the bot.
  teamsConversationId String?
  role                Role     @default(EMPLOYEE)
  managerEmails       String[] // Array of emails this person reports to
  hrEmail             String? // Assigned HR business partner's email, set directly by Admin/HR
  passwordHash        String? // Web dashboard login; null means the account can't log in yet

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  isProvisional Boolean   @default(false) // true when auto-created by the bot pending admin review

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  attendances   Attendance[]
  leaves        Leave[]
  notifications Notification[]

  // Teams group chats this person's attendance/leave announcements go to. Empty means
  // "use the default groups" (TeamsGroup.isDefault) - see GroupsService.getTargetsForEmployee.
  groups TeamsGroup[] @relation("EmployeeGroups")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamsGroup {
  id             String    @id @default(uuid())
  name           String
  conversationId String    @unique // Teams conversation ID, from the bot's "/groupid" reply
  isDefault      Boolean   @default(false) // receives announcements for employees with no groups assigned
  isActive       Boolean   @default(true) // false while the bot is removed from the chat
  lastTestedAt   DateTime?

  employees Employee[] @relation("EmployeeGroups")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id        String     @id @default(uuid())
  name      String
  startTime String // e.g. "09:00"
  endTime   String // e.g. "18:00"
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leave {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType       String
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveStatus @default(PENDING)
  // Set together for an hourly leave ("permission") on startDate - wall-clock "HH:mm"
  // in the company timezone. Null for full-day leave.
  startTime       String?
  endTime         String?
  durationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id            String  @id @default("default")
  // Legacy comma-separated group list, superseded by TeamsGroup (its IDs were copied
  // there as default groups). No longer read - kept only so a rollback still works.
  commonGroupId String?
  // Captured from incoming Teams activities so the web dashboard can send proactive
  // messages (e.g. a group's test message) without an active bot turn.
  botServiceUrl String?
  botTenantId   String?

  // Reminders (1:1 chat) and group digests. Times are company wall clock "HH:mm".
  // Check-in/out reminders use the employee's shift times when they have a shift.
  remindersEnabled     Boolean @default(true)
  checkInReminderTime  String  @default("10:00")
  checkOutReminderTime String  @default("19:00")
  digestsEnabled       Boolean @default(true)
  morningDigestTime    String  @default("10:30")
  eveningDigestTime    String  @default("20:00")
  // ISO weekdays (1 = Mon ... 7 = Sun) reminders and digests run on.
  workingDays          Int[]   @default([1, 2, 3, 4, 5])
}

/// One row per reminder/digest already sent, keyed like "checkin:<employeeId>:2026-10-05",
/// so a send happens once even across restarts or several instances.
model ScheduledSend {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Yearly allowance per leave type. Types without a policy have no limit.
model LeavePolicy {
  leaveType  String @id
  annualDays Int

  updatedAt DateTime @updatedAt
}

model Attendance {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date              DateTime  @default(now()) @db.Date
  checkIn           DateTime
  checkOut          DateTime?
  workingMinutes    Int       @default(0)
  breakMinutes      Int       @default(0)
  permissionMinutes Int       @default(0)
  status            String    @default("checked_in")
  autoCheckedOut    Boolean   @default(false) // closed by the midnight sweep, not the employee

  breaks       AttendanceBreak[]
  dailyTasks   DailyTask[]
  dailySummary DailySummary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceBreak {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  breakStart   DateTime
  breakEnd     DateTime?
  duration     Int        @default(0) // in minutes
  type         String     @default("break") // "break" | "lunch"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTask {
  id               String     @id @default(uuid())
  attendanceId     String
  attendance       Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  date             DateTime   @default(now()) @db.Date
  taskName         String // Can be text or a link
  position         Int        @default(0) // order the employee entered the tasks in
  priority         String     @default("normal")
  estimatedMinutes Int        @default(0)
  timeTakenMinutes Int        @default(0)
  status           String     @default("not_started") // not_started, in_progress, completed
  remarks          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailySummary {
  id            String     @id @default(uuid())
  attendanceId  String     @unique
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  overallStatus String
  blockerType   String?
  remarks       String?
  submittedAt   DateTime   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([employeeId, readAt])
}
