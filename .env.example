# Postgres connection string (Prisma). A free dev instance from
# https://console.prisma.io/ works fine, or point this at any Postgres.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Port the NestJS server listens on. Defaults to 3000 if unset.
PORT=3000

# Teams/Bot Framework app registration credentials. Required for the bot to
# authenticate with the Bot Framework Service; the web dashboard works
# without them. CLIENTID/CLIENTSECRET (no underscore) and
# MicrosoftAppId/MicrosoftAppPassword are also accepted as fallbacks.
CLIENT_ID=
CLIENT_SECRET=

# Optional: only needed for a single-tenant app registration.
# MicrosoftAppTenantId=

# Secret used to sign login JWTs. Required - the app fails fast on boot if
# this is missing. Generate one with `openssl rand -base64 32`.
JWT_SECRET=

# How long an issued JWT stays valid. Defaults to 8h if unset.
JWT_EXPIRES_IN=8h

NODE_ENV=development

# Optional: password assigned to every seeded account by `prisma db seed`.
# Defaults to "password" if unset - override for anything beyond local dev.
# SEED_ADMIN_PASSWORD=
